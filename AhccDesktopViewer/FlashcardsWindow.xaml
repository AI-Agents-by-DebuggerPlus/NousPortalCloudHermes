<Window x:Class="AhccDesktopViewer.FlashcardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AHCCDV Flashcards"
        Icon="pack://application:,,,/Assets/AhccDv.ico"
        Height="640"
        Width="520"
        MinHeight="420"
        MinWidth="380"
        Background="#0B1F2A"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseMove="Window_MouseMove">
    <Grid>
        <Grid x:Name="ContentGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Flashcards"
                   Foreground="#E8F4F3" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Grid.Row="1"
                   Text="Команды генерации отправляет AHCC агенту Hermes."
                   Foreground="#8AA8A6" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,16" />

        <Border Grid.Row="2" Background="#123D45" CornerRadius="12" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ENGLISH" Foreground="#8AA8A6" FontSize="12" Margin="0,0,0,8" />
                <TextBlock x:Name="EnglishText" Text="—"
                           Foreground="#E8F4F3" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="РУССКИЙ" Foreground="#8AA8A6" FontSize="12" Margin="0,24,0,8" />
                <TextBlock x:Name="RussianText" Text="—"
                           Foreground="#1FA6A0" FontSize="28" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="HistoryCaption" Grid.Row="3" Text="Ранее" Foreground="#8AA8A6" FontSize="12" Margin="0,16,0,6" />
        <ListBox x:Name="HistoryList" Grid.Row="4"
                 Background="#123D45" Foreground="#E8F4F3" BorderBrush="#2A5A62"
                 SelectionChanged="HistoryList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="#E8F4F3" />
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="#123D45" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A4550" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" Foreground="#E8F4F3" TextWrapping="Wrap" Margin="4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        <Border x:Name="BlankOverlay" Background="#000000" Visibility="Collapsed" />
    </Grid>
</Window>
