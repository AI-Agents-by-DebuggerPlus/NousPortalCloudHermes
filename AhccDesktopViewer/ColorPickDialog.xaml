<Window x:Class="AhccDesktopViewer.ColorPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color"
        Width="340"
        SizeToContent="Height"
        MinHeight="260"
        Background="#0B1F2A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#E8F4F3" VerticalAlignment="Center" />
            <Slider x:Name="RSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,6" ValueChanged="Slider_Changed" />
            <TextBlock x:Name="RLabel" Grid.Row="0" Grid.Column="2" Foreground="#E8F4F3" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#E8F4F3" VerticalAlignment="Center" />
            <Slider x:Name="GSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,6" ValueChanged="Slider_Changed" />
            <TextBlock x:Name="GLabel" Grid.Row="1" Grid.Column="2" Foreground="#E8F4F3" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#E8F4F3" VerticalAlignment="Center" />
            <Slider x:Name="BSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,6" ValueChanged="Slider_Changed" />
            <TextBlock x:Name="BLabel" Grid.Row="2" Grid.Column="2" Foreground="#E8F4F3" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="Preview" Height="40" Margin="0,4,0,16" CornerRadius="6"
                BorderBrush="#2A5A62" BorderThickness="1" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="88" Height="34" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="88" Height="34" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
