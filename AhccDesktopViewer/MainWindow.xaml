<Window x:Class="AhccDesktopViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AHCC Desktop Viewer"
        Height="720"
        Width="980"
        MinHeight="480"
        MinWidth="720"
        Background="#0B1F2A"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="ChromeBar" Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Logs" Width="80" Height="32" Margin="0,0,8,0" Click="Logs_Click" />
                <Button Content="Refresh" Width="90" Height="32" Margin="0,0,8,0" Click="Refresh_Click" />
                <Button x:Name="ConnectButton" Content="Connect" Width="100" Height="32" Click="Connect_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="AHCC Desktop Viewer"
                           Foreground="#E8F4F3" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Disconnected"
                           Foreground="#8AA8A6" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Live">
                <Border x:Name="LivePanelBorder" Background="#123D45" CornerRadius="10" Padding="14" Margin="0,8,0,0"
                        BorderThickness="0">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BubbleBrush}"
                                            CornerRadius="{Binding BubbleCornerRadius}"
                                            Padding="{Binding BubblePadding}"
                                            Margin="{Binding BubbleMargin}"
                                            BorderThickness="0"
                                            MouseLeftButtonUp="Bubble_Click" Cursor="Hand" Tag="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}"
                                                       Foreground="#8AA8A6" FontSize="11" Margin="0,0,0,4"
                                                       Visibility="{Binding SenderVisibility}" />
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{Binding TextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{Binding FontSize}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Session ID (from Supabase last row)" Foreground="#8AA8A6" Margin="0,0,0,4" />
                        <TextBox x:Name="SessionIdBox" Margin="0,0,0,12" Padding="8" IsReadOnly="True" />
                        <TextBlock Text="Supabase URL" Foreground="#8AA8A6" Margin="0,0,0,4" />
                        <TextBox x:Name="SupabaseUrlBox" Margin="0,0,0,12" Padding="8" />
                        <TextBlock Text="Supabase anon key" Foreground="#8AA8A6" Margin="0,0,0,4" />
                        <TextBox x:Name="SupabaseKeyBox" Margin="0,0,0,12" Padding="8" />

                        <Button Content="Appearance (fonts &amp; colors)…" Width="240" Height="34"
                                HorizontalAlignment="Left" Margin="0,0,0,16" Click="Appearance_Click" />

                        <TextBlock Text="Poll interval (seconds, 0 = off)" Foreground="#8AA8A6" Margin="0,0,0,4" />
                        <TextBox x:Name="PollSecondsBox" Width="80" HorizontalAlignment="Left"
                                 Margin="0,0,0,12" Padding="8" Text="5" />
                        <CheckBox x:Name="AutoConnectCheck" Content="Connect on launch"
                                  Foreground="#E8F4F3" Margin="0,0,0,12" />
                        <Button Content="Save settings" Width="140" Height="34" HorizontalAlignment="Left"
                                Click="SaveSettings_Click" />
                        <TextBlock Margin="0,16,0,0" Foreground="#8AA8A6" TextWrapping="Wrap"
                                   Text="Open Appearance to adjust fonts and colors with live preview on the Live tab." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hot Keys">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Fullscreen (chat only)" Foreground="#8AA8A6" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HotKeyBox" Width="80" Padding="8" MaxLength="1" />
                        <TextBlock Text="(default F — press again to exit)"
                                   Foreground="#8AA8A6" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <Button Content="Save hot keys" Width="140" Height="34" Margin="0,16,0,0"
                            HorizontalAlignment="Left" Click="SaveSettings_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border x:Name="FullscreenOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#0B1F2A"
                Visibility="Collapsed"
                BorderThickness="0"
                Padding="48">
            <ScrollViewer x:Name="FsScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FsMessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BubbleBrush}"
                                    CornerRadius="{Binding BubbleCornerRadius}"
                                    Padding="{Binding BubblePadding}"
                                    Margin="{Binding BubbleMargin}"
                                    BorderThickness="0"
                                    MouseLeftButtonUp="Bubble_Click" Cursor="Hand" Tag="{Binding}"
                                    MaxWidth="960" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}"
                                               Foreground="#8AA8A6" FontSize="12" Margin="0,0,0,6"
                                               Visibility="{Binding SenderVisibility}" />
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding TextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="{Binding FontSize}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border x:Name="ToastBanner"
                Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Padding="20,12"
                Background="#1A4550"
                CornerRadius="8"
                BorderBrush="#2A5A62"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="300">
            <TextBlock x:Name="ToastText"
                       Text=""
                       Foreground="#E8F4F3"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Border>

        <TextBlock Grid.Row="2" x:Name="FooterText" Panel.ZIndex="1"
                   Foreground="#6B8F8C" FontSize="11"
                   Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
