<Application x:Class="AhccDesktopViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Light text on dark surfaces (project UI rule) -->
        <SolidColorBrush x:Key="AhccBg" Color="#0B1F2A" />
        <SolidColorBrush x:Key="AhccSurface" Color="#123D45" />
        <SolidColorBrush x:Key="AhccSurfaceAlt" Color="#1A4550" />
        <SolidColorBrush x:Key="AhccText" Color="#E8F4F3" />
        <SolidColorBrush x:Key="AhccMuted" Color="#8AA8A6" />
        <SolidColorBrush x:Key="AhccAccent" Color="#1FA6A0" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AhccSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource AhccText}" />
            <Setter Property="BorderBrush" Value="#2A5A62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245560" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource AhccText}" />
            <Setter Property="Background" Value="{StaticResource AhccSurface}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2A5A62"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AhccSurfaceAlt}" />
                                <Setter Property="Foreground" Value="{StaticResource AhccText}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#0F2A33" />
                                <Setter Property="Foreground" Value="{StaticResource AhccMuted}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245560" />
                                <Setter Property="Foreground" Value="{StaticResource AhccText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource AhccSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource AhccText}" />
            <Setter Property="CaretBrush" Value="{StaticResource AhccText}" />
            <Setter Property="BorderBrush" Value="#2A5A62" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AhccText}" />
        </Style>
    </Application.Resources>
</Application>
